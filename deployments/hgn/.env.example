# Workspaces (Plane fork) -- production configuration for the HGN VPS.
#
#   deployments/hgn/init-env.sh your.real.domain
#
# generates .env in the repository root from this template: it replaces every
# occurrence of workspaces.example.com with your domain and fills in the
# secrets. Copying this file by hand works too -- do the same substitution.
#
# This is the ONLY configuration file. Compose reads it; the Django containers
# load all of it; every other container receives exactly the values that
# docker-compose.yml forwards to it. Values are written out literally, with no
# ${...} placeholders, so nothing depends on how a particular Compose version
# treats an env file. Anything left blank under "Secrets" stops the stack from
# starting, on purpose.

# ---- Compose ---------------------------------------------------------------
# The files that make up this deployment. Because this is here, plain
# `docker compose ...` is always the right command; never add -f flags.
COMPOSE_FILE=docker-compose.yml:deployments/production/compose.yml:deployments/hgn/compose.yml
COMPOSE_PATH_SEPARATOR=:
# Fixes the volume and network prefix (workspaces_pgdata, ...) whatever the
# checkout directory is called. On an existing install this MUST match the
# prefix already in `docker volume ls`, or the stack starts with empty volumes.
COMPOSE_PROJECT_NAME=workspaces

# ---- Site ------------------------------------------------------------------
APP_DOMAIN=workspaces.example.com

# Every public URL Django and the mailer generate. All the same origin, https,
# no trailing slash. WEB_URL's scheme also prefixes every uploaded file's URL,
# so http:// here means images are blocked as mixed content.
WEB_URL=https://workspaces.example.com
APP_BASE_URL=https://workspaces.example.com
ADMIN_BASE_URL=https://workspaces.example.com
SPACE_BASE_URL=https://workspaces.example.com
LIVE_BASE_URL=https://workspaces.example.com

# Django derives SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE and
# CSRF_TRUSTED_ORIGINS from this one line. One https origin. Any http: entry
# switches secure cookies off for all of them, and sign-in then fails with a
# CSRF error that never names the cause.
CORS_ALLOWED_ORIGINS=https://workspaces.example.com

# ---- Edge: host nginx in front of Caddy ------------------------------------
# Caddy listens on 127.0.0.1:LISTEN_HTTP_PORT; deployments/hgn/nginx.conf
# terminates TLS and proxies to it. Change both together.
LISTEN_HTTP_PORT=8080
# Plain HTTP inside the box. Never a hostname here, or Caddy tries to obtain a
# certificate that nginx already holds.
SITE_ADDRESS=:80
# Who may set X-Forwarded-*: nginx, which reaches Caddy over the docker bridge.
# Not 0.0.0.0/0, which would let any client forge its own IP.
TRUSTED_PROXIES=private_ranges

# ---- Secrets ---------------------------------------------------------------
# init-env.sh generates all six. By hand: openssl rand -hex 32
#
# SECRET_KEY signs sessions and password-reset links AND encrypts the instance
# configuration rows in the database. Changing it later logs everyone out and
# makes the stored SMTP/OAuth settings unreadable. Keep a copy off the server:
# a database backup without it is only most of a backup.
SECRET_KEY=
# Guards the live server's admin endpoints.
LIVE_SERVER_SECRET_KEY=
# These three must match what is already inside the volumes on an existing
# install, or the services reject their own credentials on start-up.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Django ----------------------------------------------------------------
DEBUG=0
GUNICORN_WORKERS=4
# Upload ceiling in bytes. Django and Caddy read this; client_max_body_size in
# deployments/hgn/nginx.conf must be at least as large, or nginx rejects the
# body first and the browser only reports a generic failure.
FILE_SIZE_LIMIT=5242880
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# Attendance (the Odoo bridge). Both blank disables the feature cleanly: the
# navbar control hides itself and nothing logs an error. The API runs in a
# container, so this host must resolve from inside it. Recreate api, worker and
# beat-worker after changing either -- a restart does not pick them up.
ODOO_BASE_URL=
ODOO_API_KEY=

# ---- Backing services ------------------------------------------------------
POSTGRES_USER=plane
POSTGRES_DB=plane
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=
USE_MINIO=1

# Hostnames default to the compose service names in docker-compose.yml.
# Uncomment only to point at services outside this stack. In Django,
# DATABASE_URL, AMQP_URL and REDIS_URL each take precedence over the discrete
# variables above once set, so write them out in full.
# POSTGRES_HOST=plane-db
# RABBITMQ_HOST=plane-mq
# REDIS_URL=redis://plane-redis:6379/
# AWS_S3_ENDPOINT_URL=http://plane-minio:9000
